# Jira GRW-420 — where @growza-app/shared actually lives.
#
# It is published to GitHub Packages, not npmjs.org (publish-shared.yml in the
# growza repo, and shared/package.json's own publishConfig). Without this line
# npm looks on npmjs.org, finds nothing and reports a 404 that reads as "the
# package was never published" — which is what it looked like until someone
# checked where the publish workflow was actually pointing.
@growza-app:registry=https://npm.pkg.github.com

# The token is never committed: npm substitutes it from the environment. CI
# passes secrets.GITHUB_TOKEN; a Docker build passes it as a build secret; a
# laptop exports a PAT with read:packages.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
